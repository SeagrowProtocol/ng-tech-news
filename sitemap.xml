app.get('/sitemap.xml', async (req, res) => {
  try {
    const { rows: jobs } = await query(
      `SELECT slug, posted_at FROM jobs
       WHERE posted_at > NOW() - INTERVAL '90 days'
       ORDER BY posted_at DESC LIMIT 5000`
    );

    const FRONTEND_URL = 'https://remoteng.com.ng';
    const BACKEND_URL = 'https://remoteng-api.onrender.com';

    let xml = `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- Frontend static pages -->
  <url>
    <loc>${FRONTEND_URL}/</loc>
    <priority>1.0</priority>
    <changefreq>daily</changefreq>
  </url>
  <url>
    <loc>${FRONTEND_URL}/remote-jobs.html</loc>
    <priority>0.9</priority>
    <changefreq>daily</changefreq>
  </url>
  <url>
    <loc>${FRONTEND_URL}/tech-news.html</loc>
    <priority>0.7</priority>
    <changefreq>daily</changefreq>
  </url>
  <url>
    <loc>${FRONTEND_URL}/service.html</loc>
    <priority>0.6</priority>
    <changefreq>monthly</changefreq>
  </url>`;

    // Backend job detail pages - only if jobs exist
    if (jobs.length > 0) {
      jobs.forEach(j => {
        const date = new Date(j.posted_at).toISOString().split('T')[0];
        xml += `
  <url>
    <loc>${BACKEND_URL}/job-details.html?job=${j.slug}</loc>
    <lastmod>${date}</lastmod>
    <priority>0.8</priority>
    <changefreq>weekly</changefreq>
  </url>`;
      });
    }

    xml += `
</urlset>`;

    res.header('Content-Type', 'application/xml');
    res.send(xml);

  } catch (err) {
    log("Sitemap Error: " + err.message);
    res.status(500).send('Error generating sitemap');
  }
});
